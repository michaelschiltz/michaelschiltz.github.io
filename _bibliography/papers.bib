@misc{schiltz2026stipends,
  title        = {Stipends, Brokers, and Borrowed Time: Finance and Institutions in the Edo Capital, 1600–1868},
  author       = {Schiltz, Michael},
  year         = {2026},
  howpublished = {Figshare (preprint)},
  doi          = {10.6084/m9.figshare.31897369.v1},
  abstract     = {This chapter examines the fudasashi (札差) of Tokugawa Japan — institutions nominally classified as rice brokers but functioning in practice as the primary credit intermediaries, debt managers, and financial agents of the shogunate's bannerman (hatamoto) retainer class. Operating within the licensed guild framework of the kabu nakama (株仲間) system, the fudasashi developed sophisticated instruments of financial intermediation, yet failed to generate the corporate forms that might have enabled perpetual institutional accumulation or a transition into Meiji-era banking. The chapter argues that this failure is explained not by market underdevelopment or cultural factors, but by the absence of juridical personhood in the European sense: without entity shielding — the legal separation of firm assets from the personal assets of proprietors — the kabu nakama existed entirely within delegated bakufu authority, with no independent legal personality. Monopoly rents were channelled into conspicuous personal consumption rather than reinvestment, and the institution died with its members. The Meiji debt cancellation of the early 1870s, analysed here as a jubilee-form instrument operating outside the probability distribution the fudasashi system was designed to manage, extinguished residual claims at a recognition rate of effectively zero. The argument is developed through three comparative frames: ancient Near Eastern debt jubilee traditions and their rabbinic circumvention via the prozbul; the European corporate form and the role of entity shielding in decoupling institutional continuity from individual mortality; and the Tokugawa kabu nakama as a third path available to neither solution. Ergodicity economics provides the analytical vocabulary for understanding why recurrent bakufu interventions — sumptuary regulation from above and debt moratorium (kien-rei) from below — were structurally necessary rather than administratively contingent, and why they were insufficient. Primary sources include guild records, commission deeds, and bakufu edicts drawn from the Sumitomo Archives and Sueoka Teruaki's Tokugawa Bakushindan to Edo no Kinyu-shi 徳川幕臣団と江戸の金融史: 札差・両替商の研究 (2024).},
  selected     = {true},
  abbr         = {Preprint},
  bibtex_show  = {true}
}

